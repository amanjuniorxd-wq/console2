--- a/rpcs3/util/media_utils.cpp
+++ b/rpcs3/util/media_utils.cpp
@@ -21,6 +21,24 @@ extern "C" {
 #include "libswscale/swscale.h"
 #include "libswresample/swresample.h"
 }
+
+// Mishrin build compat: Ubuntu 24.04 ships FFmpeg 6.1 (libavcodec 60), which predates avcodec_get_supported_config.
+#if LIBAVCODEC_VERSION_INT < AV_VERSION_INT(61, 13, 100)
+enum AVCodecConfig { AV_CODEC_CONFIG_SAMPLE_FORMAT, AV_CODEC_CONFIG_SAMPLE_RATE, AV_CODEC_CONFIG_CHANNEL_LAYOUT };
+static int avcodec_get_supported_config(const AVCodecContext*, const AVCodec* c, AVCodecConfig cfg, unsigned, const void** out, int* num)
+{
+	*out = nullptr;
+	int n = 0;
+	switch (cfg)
+	{
+	case AV_CODEC_CONFIG_SAMPLE_FORMAT: if (c->sample_fmts) { while (c->sample_fmts[n] != AV_SAMPLE_FMT_NONE) n++; *out = c->sample_fmts; } break;
+	case AV_CODEC_CONFIG_SAMPLE_RATE: if (c->supported_samplerates) { while (c->supported_samplerates[n]) n++; *out = c->supported_samplerates; } break;
+	case AV_CODEC_CONFIG_CHANNEL_LAYOUT: if (c->ch_layouts) { while (c->ch_layouts[n].nb_channels) n++; *out = c->ch_layouts; } break;
+	}
+	*num = n;
+	return 0;
+}
+#endif
 constexpr int averror_eof = AVERROR_EOF; // workaround for old-style-cast error
 constexpr int averror_invalid_data = AVERROR_INVALIDDATA; // workaround for old-style-cast error
