{
 "name": "pcsx2", "runtime": "ps2", "version": "set-me",
 "binary": "pcsx2/usr/bin/pcsx2-qt",
 "argv": ["{binary}", "-nogui", "-fullscreen", "--", "{boot}"],
 "home": "home",
 "firmware": { "label": "PS2 BIOS", "required": [".config/PCSX2/bios/bios.bin"] },
 "saves": [".config/PCSX2/memcards", ".config/PCSX2/sstates"],
 "exclude": ["*/cache/*", "*.log"],
 "env": { "QT_QPA_PLATFORM": "xcb" }
}
