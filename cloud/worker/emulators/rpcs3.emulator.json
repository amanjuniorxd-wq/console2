{
 "name": "rpcs3", "runtime": "ps3", "version": "set-me",
 "binary": "rpcs3/usr/bin/rpcs3",
 "argv": ["{binary}", "--no-gui", "{boot}"],
 "home": "home",
 "firmware": { "label": "PS3 system software", "required": [".config/rpcs3/dev_flash/vsh/module/vsh.self"] },
 "saves": [".config/rpcs3/dev_hdd0/home"],
 "exclude": ["*/cache/*", "*.log"],
 "env": { "QT_QPA_PLATFORM": "xcb" }
}
